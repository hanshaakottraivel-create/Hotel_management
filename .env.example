# PORT: The port the Express production/development server listens on (default: 3000)
PORT=3000

# NODE_ENV: Set to 'production' in deployed environments
NODE_ENV=production

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# SUPABASE_ANON_KEY: The public anon key for your Supabase project
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Optional backend service role key for elevated database operations
SUPABASE_SERVICE_ROLE_KEY=
